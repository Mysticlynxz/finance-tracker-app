{
  "expo": {
    "name": "Vittiqo",
    "slug": "spendwise",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/branding/vittiqo-app-icon-1024.png",
    "scheme": "spendwise",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/branding/vittiqo-logo-transparent.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F5ED"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.spendwise.app",
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/vittiqo-kolam-v-transparent.png",
        "backgroundColor": "#F7F5ED"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/branding/vittiqo-app-icon-1024.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-av",
        {
          "microphonePermission": "Allow $(PRODUCT_NAME) to use your microphone to record voice expenses."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/branding/vittiqo-logo-transparent.png",
          "imageWidth": 260,
          "android": {
            "image": "./assets/branding/vittiqo-kolam-v-transparent.png",
            "backgroundColor": "#F7F5ED",
            "imageWidth": 135
          },
          "ios": {
            "image": "./assets/branding/vittiqo-logo-transparent.png",
            "imageWidth": 260
          },
          "resizeMode": "contain",
          "backgroundColor": "#F7F5ED"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "73d9424d-c84c-4476-b8b6-50673997d050"
      }
    },
    "owner": "krishnansn"
  }
}
