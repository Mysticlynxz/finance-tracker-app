# Server-side Appwrite Function configuration.
# Appwrite supplies APPWRITE_FUNCTION_API_ENDPOINT and APPWRITE_FUNCTION_PROJECT_ID
# to deployed functions. The handler accepts APPWRITE_ENDPOINT and
# APPWRITE_PROJECT_ID as optional overrides.
# APPWRITE_ENDPOINT=https://<your-appwrite-endpoint>/v1
# APPWRITE_PROJECT_ID=replace-with-your-appwrite-project-id

# Function settings currently read by functions/ai-advisor/index.js:
APPWRITE_DATABASE_ID=replace-with-your-appwrite-database-id
APPWRITE_EXPENSES_COLLECTION_ID=expenses
APPWRITE_BUDGETS_COLLECTION_ID=budgets
GEMINI_API_KEY=replace-with-your-server-side-gemini-api-key

# Voice transcription credentials are server-side only.
GNANI_API_KEY=replace-with-your-server-side-gnani-api-key
