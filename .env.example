# Public Appwrite client configuration only. These values are identifiers/endpoints,
# not secrets. lib/appwrite.ts and lib/categoryService.ts read these settings;
# existing project values remain as defaults when a variable is left unset.
EXPO_PUBLIC_APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
EXPO_PUBLIC_APPWRITE_PROJECT_ID=replace-with-your-appwrite-project-id
EXPO_PUBLIC_APPWRITE_DATABASE_ID=replace-with-your-appwrite-database-id
EXPO_PUBLIC_APPWRITE_EXPENSES_COLLECTION_ID=expenses
EXPO_PUBLIC_APPWRITE_BUDGETS_COLLECTION_ID=budgets
EXPO_PUBLIC_APPWRITE_CATEGORIES_COLLECTION_ID=categories
EXPO_PUBLIC_APPWRITE_AI_ADVISOR_FUNCTION_ID=replace-with-your-appwrite-function-id

# Never put Gemini or Gnani credentials in EXPO_PUBLIC_ variables.
# Configure provider credentials only in the Appwrite ai-advisor Function.

# Public client configuration (not a secret); matches the existing Function ID.
EXPO_PUBLIC_CATEGORY_BUDGETS_FUNCTION_ID=category-budgets
